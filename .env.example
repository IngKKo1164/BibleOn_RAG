# Set keys in this repository's .env.local; never commit actual keys.
# OpenAI: retrieval selection and answer generation.
OPENAI_API_KEY=
# Qwen: text-embedding-v4 for document/query vectors only.
QWEN_API_KEY=
QWEN_WORKSPACE_ID=

BIBLE_AI_PROVIDER=openai
BIBLE_RETRIEVAL_VERSION=v4
BIBLE_RAG_MODE=hybrid
BIBLE_RAG_SPEED=integrated
BIBLE_RAG_STUDY=one-hop
BIBLE_RETRIEVAL_REPAIR=on
BIBLE_REPAIR_QUERY_EXPANSION=on
