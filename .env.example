# Keys remain in B/.env.local; never copy app credentials or commit real keys.
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_WORKSPACE_ID=

# auto: LLM intent/needs, then one essential need -> simple, two or more -> adaptive.
# Both automatic routes review actual evidence; simple never escalates or retries retrieval.
# Fixed profiles below remain comparison controls, not automatic routing.
# simple: common routing, hybrid retrieval, rank-only selection, generation.
# adaptive: need-based searches, model selection/review, at most one recovery.
# Neither condition is promoted from offline tests; compare actual answers.
BIBLE_RESEARCH_PROFILE=auto
# This is an asset identity constraint, not a performance tuning knob.
BIBLE_EMBEDDING_DIMENSIONS=1024
